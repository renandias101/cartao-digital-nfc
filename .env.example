# ---------------------------------------------------------------------------
# Modelo de variáveis de ambiente. Copie para `.env.local` e preencha.
# NUNCA faça commit de `.env.local` nem de valores reais neste arquivo.
#
# As chaves `anon` e `service_role` (formato JWT) estão sendo descontinuadas
# pelo Supabase. Este projeto usa os formatos atuais: `sb_publishable_...` e
# `sb_secret_...`.
# ---------------------------------------------------------------------------

# URL do projeto Supabase. Exposta ao navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (`sb_publishable_...`). Exposta ao navegador por design:
# o isolamento entre clientes é garantido por RLS no banco, nunca por esconder
# esta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (`sb_secret_...`). IGNORA RLS.
# Uso restrito a rotinas administrativas no servidor. Nunca prefixar com
# NEXT_PUBLIC_ e nunca importar em componente de cliente.
SUPABASE_SECRET_KEY=

# Origem usada para montar a URL gravada no cartão NFC (PRD §6).
# Sem barra no final. Ex.: https://meudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp de contato para renovação, exibido no painel do cliente (PRD §25).
NEXT_PUBLIC_WHATSAPP_RENOVACAO=5596981233398
